# Runtime
NODE_ENV=development
PORT=3001

# Railway PostgreSQL: set DATABASE_URL to the Railway Postgres service's private connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/abdul_backend?schema=public

# Exact public origin of the Next.js frontend (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Generate a random secret, e.g. openssl rand -base64 32. Used to hash opaque sessions.
SESSION_HASH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Optional: only set when frontend and API use subdomains of the same custom root domain.
# Example: .abdulict.com
COOKIE_DOMAIN=

# Optional first-deploy bootstrap credentials. The first startup creates the admin if it does not exist; remove ADMIN_INITIAL_PASSWORD after successful deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
