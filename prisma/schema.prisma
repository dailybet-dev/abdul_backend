generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  displayName  String         @default("Administrator")
  passwordHash String
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  lastSeen  DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model Category {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  icon          String        @default("📦")
  description   String        @default("")
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subcategories Subcategory[]
  products      Product[]

  @@index([name])
  @@index([sortOrder])
}

model Subcategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  sortOrder   Int       @default(0)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
  @@index([sortOrder])
  @@index([categoryId])
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  Product[]

  @@index([name])
}

enum ProductConditionType {
  BRAND_NEW
  UK_USED
  PREMIUM_REPACK
}

model Product {
  id            String             @id @default(cuid())
  name          String
  slug          String             @unique
  sku           String             @unique
  description   String             @default("")
  categoryId    String?
  subcategoryId String?
  brandId       String?
  category      Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory   Subcategory?       @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  brand         Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  conditions    ProductCondition[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([name])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([brandId])
}

model ProductCondition {
  id          String               @id @default(cuid())
  productId   String
  condition   ProductConditionType
  price       Int                  @default(0)
  salePrice   Int?
  stock       Int                  @default(0)
  isAvailable Boolean              @default(true)
  images      String[]             @default([])
  product     Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([productId, condition])
  @@index([condition])
  @@index([isAvailable, stock])
}


model Service {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  category          String   @default("ICT & Electrical")
  description       String   @default("")
  homeDescription   String   @default("")
  imageUrl          String   @default("")
  icon              String   @default("Wrench")
  whatsappMessage   String   @default("")
  intro             String   @default("")
  detailDescription String   @default("")
  detailItems       String[] @default([])
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([title])
  @@index([sortOrder])
  @@index([isActive, sortOrder])
}


enum EnquiryStatus {
  NEW
  IN_PROGRESS
  REPLIED
  ARCHIVED
}

model NewsletterSubscription {
  id             String   @id @default(cuid())
  email          String   @unique
  status         String   @default("ACTIVE")
  source         String   @default("website")
  subscribedAt   DateTime @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, subscribedAt])
}

model ContactSubmission {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String        @default("")
  service   String
  message   String
  status    EnquiryStatus @default(NEW)
  adminNote String        @default("")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model TrainingEnquiry {
  id            String        @id @default(cuid())
  fullName      String
  phone         String
  email         String        @default("")
  course        String
  level         String
  schedule      String
  startDate     String        @default("")
  goal          String        @default("")
  notes         String        @default("")
  status        EnquiryStatus @default(NEW)
  adminNote     String        @default("")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}
