{
  "name": "abdul-backend",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS GraphQL and REST API with Prisma/PostgreSQL admin sessions",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,prisma}/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "admin:create": "node dist/scripts/create-admin.js",
    "admin:bootstrap": "node dist/scripts/bootstrap-admin.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@nestjs/apollo": "^13.1.0",
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/graphql": "^13.1.0",
    "@nestjs/platform-express": "^11.0.12",
    "@prisma/client": "^6.5.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "graphql": "^16.10.0",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@nestjs/throttler": "^6.4.0",
    "prisma": "^6.5.0",
    "@as-integrations/express5": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.3",
    "@nestjs/testing": "^11.0.5",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
